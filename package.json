{
  "name": "pizzaria-forno-de-pedra",
  "description": "Vitrine demonstrativa de site para pizzarias: cardápio digital, carrinho, frete por bairro e pedido via WhatsApp.",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --port=3000",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --port=3000",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && firebase deploy --only hosting"
  },
  "dependencies": {
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
